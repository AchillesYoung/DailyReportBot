[Unit]
Description=AI RSS Daily Report (AIHOT Daily)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/dailybot
EnvironmentFile=-/opt/dailybot/config/dingtalk.env
ExecStart=/opt/dailybot/.venv/bin/python -m dailybot --edition morning --group "AIHOT 日报"
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
