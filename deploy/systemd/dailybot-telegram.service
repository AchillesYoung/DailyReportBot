[Unit]
Description=Telegram to DingTalk Reporter
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/dailybot
EnvironmentFile=-/etc/telegram-dingtalk-forwarder.env
EnvironmentFile=-/opt/dailybot/.env
ExecStart=/opt/dailybot/.venv/bin/python -m dailybot.telegram_reporter
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
