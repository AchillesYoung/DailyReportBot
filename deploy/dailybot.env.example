# 环境变量样例，复制为 .env 后填入真实值
# 两个业务共用同一个钉钉机器人
#
# 兼容说明：代码同时支持 DINGTALK_WEBHOOK_URL（新）和 DINGTALK_WEBHOOK（旧）
# 优先读取 DINGTALK_WEBHOOK_URL，不存在时回退到 DINGTALK_WEBHOOK

DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN
# 或者使用旧变量名：
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN

DINGTALK_SECRET=SECxxxxxxxxxxxxxxxx

# Telegram 转发专用（可选，有默认值）
# TELEGRAM_CHANNEL=aiwizz
# FORWARDER_STATE_FILE=/opt/dailybot/state.json
